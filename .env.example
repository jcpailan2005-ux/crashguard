# Example frontend environment variables for CARCRASH
# Copy this file to .env.local and update the backend URL for your FastAPI server.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_MEANINGFUL_CONFIDENCE_THRESHOLD=0.3
NEXT_PUBLIC_ALERT_DEBOUNCE_MS=4500
NEXT_PUBLIC_DUPLICATE_HISTORY_WINDOW_MS=8000
NEXT_PUBLIC_LIVE_SESSION_PUBLISH_INTERVAL_MS=3000
NEXT_PUBLIC_RESPONDER_ALERT_DEBOUNCE_MS=10000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080

# Backend detector tuning
VIDEO_FRAME_SKIP=0
VIDEO_ANALYSIS_FPS=3.0
ACCIDENT_HEURISTIC_SCORE_THRESHOLD=0.20
MOTORCYCLE_OVERLAP_MIN_AREA_THRESHOLD=0.10
MOTORCYCLE_IOU_THRESHOLD=0.045
ENABLE_BACKEND_MEMORY_INCIDENTS=false
DEMO_FALLBACK_LATITUDE=7.1907
DEMO_FALLBACK_LONGITUDE=125.4553

# Optional local Tapo/IP camera settings for FastAPI.
# Do not commit real credentials. Prefer .env.local or backend/local_camera_config.json.
TAPO_CAMERA_LABEL=
TAPO_CAMERA_IP=
TAPO_CAMERA_AREA_ID=
TAPO_CAMERA_LOCATION=
TAPO_CAMERA_USERNAME=
TAPO_CAMERA_PASSWORD=
TAPO_STREAM_TYPE=stream2
TAPO_RTSP_PORT=554

# Live camera monitoring tuning
LIVE_CAMERA_DETECTION_INTERVAL_MS=500
CRASH_UI_THRESHOLD=0.80
CRASH_CASE_THRESHOLD=0.90
CRASH_REQUIRED_CONSECUTIVE_FRAMES=3
CRASH_ALERT_COOLDOWN_SECONDS=60
# Optional normalized road/traffic ROI as x1,y1,x2,y2. Example: 0.05,0.25,0.95,0.95
CRASH_ROI_NORMALIZED=
ENABLE_DEMO_HEURISTIC_CRASH=false
# Debug-only endpoint /api/debug/create-camera-alert creates cases unconditionally.
# Keep disabled outside local demos so no path can bypass crash gating.
ENABLE_DEBUG_CAMERA_ALERT=false
# Emergency master switch, enforced in backend/repositories/crash_cases.py.
# Set to false to immediately stop ALL crash case + notification creation
# (detection and SSE decision logs keep running) while investigating false alarms.
ENABLE_CRASH_CASE_CREATION=true
LIVE_CAMERA_VEHICLE_CONFIDENCE_THRESHOLD=0.40
LIVE_CAMERA_FRAME_WIDTH=640
LIVE_CAMERA_FRAME_HEIGHT=360
LIVE_CAMERA_BUFFER_SIZE=1
LIVE_CAMERA_FREEZE_TIMEOUT_SECONDS=10
LIVE_CAMERA_PREVIEW_FPS=10
LIVE_CAMERA_JPEG_QUALITY=75

# Frame quality gate (backend/services/frame_quality.py). Runs before crash
# decision logic on every analyzed frame; a frame that fails these checks can
# never contribute to a confirmed_crash decision.
ENABLE_FRAME_QUALITY_GATE=true
# Laplacian variance floor; frames below this are rejected as too blurry.
FRAME_BLUR_THRESHOLD=80
# Grayscale mean floor/ceiling for brightness (0-255).
FRAME_DARK_THRESHOLD=35
FRAME_OVEREXPOSED_THRESHOLD=220
# Grayscale standard deviation floor for contrast.
FRAME_LOW_CONTRAST_THRESHOLD=20
