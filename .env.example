# Example frontend environment variables for CARCRASH
# Copy this file to .env.local and update the backend URL for your FastAPI server.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8010
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_MEANINGFUL_CONFIDENCE_THRESHOLD=0.3
NEXT_PUBLIC_ALERT_DEBOUNCE_MS=4500
NEXT_PUBLIC_DUPLICATE_HISTORY_WINDOW_MS=8000
NEXT_PUBLIC_LIVE_SESSION_PUBLISH_INTERVAL_MS=3000
NEXT_PUBLIC_RESPONDER_ALERT_DEBOUNCE_MS=10000

# SQLite operational database and secure sessions.
CRASHGUARD_SQLITE_PATH=data/crashguard-operations.sqlite
# Generate unique local/production values; never commit real credentials.
CRASHGUARD_SESSION_TTL_SECONDS=604800
CRASHGUARD_SECURE_COOKIES=false
CAMERA_STREAM_SIGNING_SECRET=<generate-a-random-secret>


# Responder presence. Clients heartbeat every 25 seconds; sessions older than
# this timeout are shown as offline without relying on an explicit logout.
CRASHGUARD_RESPONDER_ONLINE_TIMEOUT_SECONDS=60

# Backend detector tuning
VIDEO_FRAME_SKIP=0
VIDEO_ANALYSIS_FPS=3.0
ACCIDENT_HEURISTIC_SCORE_THRESHOLD=0.20
MOTORCYCLE_OVERLAP_MIN_AREA_THRESHOLD=0.10
MOTORCYCLE_IOU_THRESHOLD=0.045
ENABLE_BACKEND_MEMORY_INCIDENTS=false
DEMO_FALLBACK_LATITUDE=7.1907
DEMO_FALLBACK_LONGITUDE=125.4553

# Optional local Tapo/IP camera settings for FastAPI.
# Do not commit real credentials. Prefer .env.local or backend/local_camera_config.json.
TAPO_CAMERA_LABEL=
TAPO_CAMERA_IP=
TAPO_CAMERA_AREA_ID=
TAPO_CAMERA_LOCATION=
TAPO_CAMERA_USERNAME=
TAPO_CAMERA_PASSWORD=
TAPO_STREAM_TYPE=stream2
TAPO_RTSP_PORT=554

# Live camera monitoring tuning
LIVE_CAMERA_DETECTION_INTERVAL_MS=500
CRASH_UI_THRESHOLD=0.80
CRASH_CASE_THRESHOLD=0.90
CRASH_REQUIRED_CONSECUTIVE_FRAMES=3
CRASH_ALERT_COOLDOWN_SECONDS=60
# Optional normalized road/traffic ROI as x1,y1,x2,y2. Example: 0.05,0.25,0.95,0.95
CRASH_ROI_NORMALIZED=
ENABLE_DEMO_HEURISTIC_CRASH=false
# Debug-only endpoint /api/debug/create-camera-alert creates cases unconditionally.
# Keep disabled outside local demos so no path can bypass crash gating.
ENABLE_DEBUG_CAMERA_ALERT=false
# Emergency master switch, enforced in backend/repositories/crash_cases.py.
# Set to false to immediately stop ALL crash case + notification creation
# (detection and SSE decision logs keep running) while investigating false alarms.
ENABLE_CRASH_CASE_CREATION=true
LIVE_CAMERA_VEHICLE_CONFIDENCE_THRESHOLD=0.40
# Phase 2: lower-confidence vehicles are context-gated collision evidence only.
# This does not change vehicleCount or the trusted threshold above.
COLLISION_CANDIDATE_VEHICLE_CONFIDENCE_THRESHOLD=0.25
# Detector observation floor used only to expose REJECTED diagnostics. Boxes
# below the 0.25 candidate floor never reach candidate evaluation or ByteTrack.
COLLISION_RAW_VEHICLE_CONFIDENCE_FLOOR=0.10
COLLISION_CANDIDATE_MODEL1_SUPPORT_THRESHOLD=0.60
COLLISION_CANDIDATE_PERSISTENCE_OBSERVATIONS=2
COLLISION_CANDIDATE_PERSISTENCE_WINDOW_SECONDS=2.0
COLLISION_CANDIDATE_STALE_AFTER_SECONDS=2.0
COLLISION_CANDIDATE_TRUSTED_CONTEXT_SECONDS=2.0
# Phase 4 bounded native-frame vehicle-pair classification. Pair scores are
# diagnostic supporting evidence only and cannot independently create a case.
MAX_COLLISION_PAIR_CLASSIFICATIONS=1
COLLISION_PAIR_CONTEXT_MARGIN=0.20
COLLISION_PAIR_DEBUG_LOG=false
# Phase 5 CrashGuard-level logical continuity above ByteTrack. The 1.0-second
# default covers one missed 500 ms AI cycle without retaining stale identities.
TRACK_HANDOFF_MAX_SECONDS=1.0
TRACK_HANDOFF_MAX_DISPLACEMENT=0.15
TRACK_HANDOFF_MIN_SIZE_SIMILARITY=0.30
TRACK_HANDOFF_MIN_SCORE=0.62
TRACK_HANDOFF_AMBIGUITY_MARGIN=0.08
TRACK_CONTINUITY_MAX_IDENTITIES=64
TRACK_CONTINUITY_DEBUG_LOG=false
# Safe structured tier diagnostics; disabled by default to avoid noisy logs.
VEHICLE_DETECTION_DEBUG_LOG=false
LIVE_CAMERA_FRAME_WIDTH=640
LIVE_CAMERA_FRAME_HEIGHT=360
# Model 2 vehicle input. 0x0 uses the native decoded frame and avoids an
# extra OpenCV resize; positive values are treated as aspect-preserving bounds.
LIVE_CAMERA_AI_FRAME_WIDTH=0
LIVE_CAMERA_AI_FRAME_HEIGHT=0
LIVE_CAMERA_YOLO_IMGSZ=640
LIVE_CAMERA_BUFFER_SIZE=1
LIVE_CAMERA_FREEZE_TIMEOUT_SECONDS=10
LIVE_CAMERA_PREVIEW_FPS=10
LIVE_CAMERA_JPEG_QUALITY=75

# Phase 4 lightweight crash-aftermath review path. This never confirms an
# observed collision; it requires tracked vehicles, abnormal geometry, and
# persistent crash-classifier support before creating a review candidate.
AFTERMATH_ENABLED=true
AFTERMATH_MIN_CLASSIFIER_SCORE=0.80
AFTERMATH_MIN_SCORE=0.80
AFTERMATH_MIN_ABNORMALITY_SCORE=0.35
AFTERMATH_REQUIRED_FRAMES=6
AFTERMATH_MIN_PERSISTENCE_SECONDS=2.5
AFTERMATH_WINDOW_SECONDS=10
AFTERMATH_CLEAR_SECONDS=2
AFTERMATH_CLEAR_NEGATIVE_FRAMES=3
AFTERMATH_COOLDOWN_SECONDS=1
AFTERMATH_SESSION_GAP_SECONDS=6
AFTERMATH_MIN_TRACK_HISTORY=3
AFTERMATH_STATIONARY_SPEED_THRESHOLD=0.018
# Structured per-evaluation diagnostic logging; leave off for normal operation.
AFTERMATH_DEBUG_LOG=false

# Frame quality gate (backend/services/frame_quality.py). Runs before crash
# decision logic on every analyzed frame; a frame that fails these checks can
# never contribute to a confirmed_crash decision.
ENABLE_FRAME_QUALITY_GATE=true
# Laplacian variance floor; frames below this are rejected as too blurry.
FRAME_BLUR_THRESHOLD=80
# Grayscale mean floor/ceiling for brightness (0-255).
FRAME_DARK_THRESHOLD=35
FRAME_OVEREXPOSED_THRESHOLD=220
# Grayscale standard deviation floor for contrast.
FRAME_LOW_CONTRAST_THRESHOLD=20
